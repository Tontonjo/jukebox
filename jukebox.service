[Unit]
Description=🎵 Jukebox - Music Application
Documentation=file:///home/debian/jukebox/README.md
After=network.target

[Service]
Type=simple
User=debian
Group=users
WorkingDirectory=/home/debian/jukebox/
Environment="NODE_ENV=production"
EnvironmentFile=-/home/debian/jukebox/.env
ExecStart=/usr/bin/node /home/debian/jukebox/jukebox-server.js

# Restart policy
Restart=on-failure
RestartSec=10

# Timeouts
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jukebox

[Install]
WantedBy=multi-user.target
