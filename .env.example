# ============= JUKEBOX - CONFIGURATION =============
# Version 1.2.0 - derniere mise a jour : 22 octobre 2026
# Copier ce fichier en .env puis l'editer :  cp .env.example .env
# Le .env ne doit JAMAIS etre committe (deja ignore par git).

# ============= SERVER =============
PORT=3000
NODE_ENV=production

# Debug
DEBUG=false
QUIET=false

# Adresse publique du jukebox, utilisée par le QR code affiché sur l'écran
# de lecture. À renseigner seulement derrière un proxy ou un nom de domaine :
# sinon le serveur détecte tout seul son adresse sur le réseau.
# PUBLIC_URL=https://jukebox.mondomaine.fr

# ============= ADMIN =============
# Mot de passe pour accéder au panneau admin
ADMIN_PASSWORD=admin123

# ============= NAVIDROME / SUBSONIC =============
# Activer Navidrome
NAVIDROME_ENABLED=true
# URL du serveur Navidrome (ex: http://192.168.1.100:4533)
NAVIDROME_URL=http://localhost:4533
# Identifiants Navidrome
NAVIDROME_USER=admin
NAVIDROME_PASS=password123

# Fondu entre deux chansons, en secondes (0 = enchaînement sec).
# Le morceau sortant descend sur cette durée et le suivant remonte sur la même.
# Modifiable aussi en direct depuis /admin.
FADE_SECONDS=3

# ============= SOULSEEK =============
# Soulseek sert de repli : il n'est interrogé que si Navidrome ne trouve rien.
# Passe par sockseek : https://github.com/fiso64/sockseek
# Un compte Soulseek est nécessaire (configuré dans sockseek.conf, pas ici).
SOULSEEK_ENABLED=false

# Compte Soulseek. Image Docker uniquement : il est écrit au démarrage dans
# la configuration du sockseek intégré. Hors Docker, les identifiants vont
# dans ~/.config/sockseek/sockseek.conf.
# SOULSEEK_USER=votre-pseudo
# SOULSEEK_PASS=votre-mot-de-passe

# Chemin de l'exécutable sockseek (laisser tel quel s'il est dans le PATH)
SOCKSEEK_PATH=sockseek

# Démon sockseek : garde la connexion Soulseek ouverte, donc bien plus rapide.
# Le jukebox le démarre tout seul au lancement (npm start) s'il n'écoute pas
# déjà à cette adresse, et l'arrête en quittant.
# Laisser vide pour lancer sockseek en autonome à chaque requête (lent).
SOCKSEEK_REMOTE=http://127.0.0.1:5030

# Passer à false pour gérer le démon soi-même (systemd, docker, lancement
# manuel : sockseek daemon --server-ip 127.0.0.1 --server-port 5030).
SOCKSEEK_AUTOSTART=true

# Dossier des téléchargements temporaires. Vidé au démarrage et à l'arrêt.
# Par défaut : <dossier du projet>/downloads
SOULSEEK_DOWNLOAD_DIR=

# Nombre de résultats proposés aux invités
SOULSEEK_MAX_RESULTS=10

# Temps que sockseek passe à collecter les réponses des pairs, en
# millisecondes. Sa valeur par défaut (6000) est courte : beaucoup de pairs
# n'ont pas le temps de répondre. Monter à 30000-40000 si les résultats
# restent maigres, au prix d'une attente plus longue pour l'invité. Réglable
# aussi à chaud depuis le panneau admin (Réglages > Délai de recherche
# Soulseek), sans redémarrer le serveur.
SOULSEEK_SEARCH_TIME=20000

# Délai maximum d'un téléchargement, en secondes
SOULSEEK_DOWNLOAD_TIMEOUT=30

# Téléchargements simultanés
SOULSEEK_MAX_DOWNLOADS=2

# Supprimer le fichier dès la fin de la lecture du morceau.
# 'false' conserve les fichiers jusqu'à l'arrêt du serveur.
SOULSEEK_DELETE_AFTER_PLAY=true

# Soulseek bannit 30 min au-delà d'environ 34 recherches par 220 s.
# On reste volontairement en deçà.
SOULSEEK_RATE_LIMIT=30

# ============= JUKEBOX SETTINGS =============
# Les invités autorisés se gèrent depuis la page /admin (liste de noms)
# Nombre maximum de chansons qu'un utilisateur peut ajouter
MAX_SONGS_PER_USER=3

# Cooldown en minutes entre chaque ajout de chanson
COOLDOWN_MINUTES=5

# Fenêtre glissante du quota, en minutes : une chanson libère sa place
# après ce délai (60 = "3 chansons par heure" avec MAX_SONGS_PER_USER=3).
# 0 = quota définitif, seul l'admin peut réinitialiser.
# Modifiable en direct depuis la page /admin.
QUOTA_WINDOW_MINUTES=60

# Durée de session en minutes (après ce délai, les stats de l'utilisateur sont réinitialisées)
SESSION_DURATION=120

# ============= MUSIQUE D'ATTENTE =============
# Ce que le jukebox joue quand plus aucune chanson d'invité n'attend son
# tour. Tout se règle depuis la page /admin (panneau « Musique d'attente ») ;
# les valeurs ci-dessous ne servent qu'au tout premier démarrage.
#
#   off      : silence entre deux chansons
#   radio    : webradio, coupée net dès qu'une chanson est ajoutée
#   playlist : playlist Navidrome, dont la piste en cours va jusqu'au bout
FALLBACK_MODE=off

# Adresse du FLUX de la webradio (pas celle du site de la radio).
# Formats acceptés : mp3, aac, ogg, et HLS (.m3u8).
FALLBACK_RADIO_URL=
# Flux HLS (.m3u8) : reconnu tout seul à l'enregistrement de l'adresse.
# À ne forcer que si la détection se trompe.
FALLBACK_RADIO_HLS=false
# Nom affiché sur l'écran de lecture. Vide = « Webradio ».
FALLBACK_RADIO_NAME=

# Identifiant de la playlist Navidrome : la liste déroulante du panneau
# admin le remplit toute seule, inutile d'y toucher ici.
FALLBACK_PLAYLIST_ID=
# Lire la playlist dans un ordre aléatoire
FALLBACK_SHUFFLE=false

# Les choix faits depuis /admin sont conservés dans ce fichier, pour
# survivre à un redémarrage. Sous Docker, montez-le sur un volume,
# sinon les réglages repartiront des valeurs ci-dessus.
# FALLBACK_STORE=./fallback.json

# ============= PAROLES =============
# Base de l'API LRClib utilisée pour les paroles synchronisées.
# À changer seulement pour pointer vers une instance auto-hébergée.
LRCLIB_BASE=https://lrclib.net/api
